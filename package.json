{
  "name": "domscout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.web.json",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "npm run build && node --env-file-if-exists=.env dist/server.js",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test:browser": "playwright test",
    "resume": "npm run check",
    "owner:create": "node --experimental-strip-types --env-file-if-exists=.env src/cli.ts owner",
    "worker": "node --experimental-strip-types --env-file-if-exists=.env src/cli.ts worker",
    "queue": "node --experimental-strip-types --env-file-if-exists=.env src/cli.ts queue",
    "import": "node --experimental-strip-types --env-file-if-exists=.env src/cli.ts import"
  },
  "dependencies": {
    "tldts": "6.1.86"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "@playwright/test": "1.65.0"
  }
}
